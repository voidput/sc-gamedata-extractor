node_modules/
dist/
*.log

# Extract dir: now only the _build.json marker (formerly raw StarBreaker output).
extracted-data/
extracted-data-full/
# Per-channel copies (make CHANNEL=PTU → extracted-data-ptu/, data-ptu/).
/extracted-data-*/

# Parsed datasets are not committed here. Publishing a build is what
# `make publish` (sc-gamedata publish) does, into the dumps repo, where one
# commit per build carrying its _build is what makes patch-over-patch diffs possible.
data/
/data-*/

overlays/
overlay-sources.json

# Checkout of the public dumps repo, managed by sc-gamedata publish.
.publish-repo/

# ephemeral extraction output
.tmp/

# Infographic exports, regenerable from data/.
exports/

# Per-build dataset copies kept by parse, for patch-over-patch diffs.
snapshots/

**/.obsidian/
/target/
