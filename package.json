{
  "name": "sc-gamedata",
  "version": "0.1.0",
  "description": "Extract Star Citizen game data (mining, blueprints, Wikelo trades, reputation, components) from the shipped game files into structured JSON.",
  "type": "module",
  "bin": {
    "sc-gamedata": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "extract": "node dist/cli.js extract",
    "parse": "node dist/cli.js parse",
    "all": "node dist/cli.js all",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "publish-dump": "node scripts/publish-dump.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
